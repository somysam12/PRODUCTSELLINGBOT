Options -Indexes
DirectoryIndex index.php index.html
AddDefaultCharset UTF-8

# Custom error page
ErrorDocument 404 /404.php

# Block direct access to sensitive file types (DB dumps, docs, configs, backups)
<FilesMatch "\.(sql|md|log|ini|sh|bak|old|bok|swp|dist|lock)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# Block sensitive folders
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^app/ - [F,L]
  RewriteRule ^writable/ - [F,L]
  # Extensionless key-verification endpoint: /validbool → validbool.php
  RewriteRule ^validbool/?$ validbool.php [L,QSA]
  # Extensionless secure endpoints — NEW app links (serve server/libs/)
  RewriteRule ^secure/auth/?$   secure/unlock.php [L,QSA]
  RewriteRule ^secure/pack/?$   secure/lib.php    [L,QSA]
  # Legacy links kept for OLD apps (serve server/libs_legacy/ when set)
  RewriteRule ^secure/unlock/?$ secure/unlock.php [L,QSA]
  RewriteRule ^secure/lib/?$    secure/lib.php    [L,QSA]
</IfModule>

# Block direct PHP access in writable/uploads
<FilesMatch "^\.env">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
</FilesMatch>

# PHP settings — raised so lib (.so up to 50MB) and APK (up to 200MB) uploads work
<IfModule mod_php7.c>
  php_value upload_max_filesize 210M
  php_value post_max_size 220M
  php_value max_execution_time 300
  php_value max_input_time 300
  php_value memory_limit 512M
  php_flag expose_php off
</IfModule>
<IfModule mod_php8.c>
  php_value upload_max_filesize 210M
  php_value post_max_size 220M
  php_value max_execution_time 300
  php_value max_input_time 300
  php_value memory_limit 512M
  php_flag expose_php off
</IfModule>
